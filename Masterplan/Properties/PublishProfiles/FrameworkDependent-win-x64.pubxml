<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-dependent single-file publish for 64-bit Windows.
     The user's PC must have the .NET 10 Desktop Runtime installed (smaller download, shared runtime).
     Run:  dotnet publish Masterplan.csproj -p:PublishProfile=FrameworkDependent-win-x64
     The Libraries\ / Projects\ folders and Manual.pdf are added by the PreparePublishFolder target
     in Masterplan.csproj. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- Only the win-x64 native files (SkiaSharp, HarfBuzz) are published, not every platform's. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Masterplan.exe + Masterplan.dll + package DLLs are bundled into one exe. The two native DLLs
         (libSkiaSharp.dll, libHarfBuzzSharp.dll) stay next to the exe on purpose: that is simpler
         and more reliable than unpacking them to a temp folder at start-up.
         Do NOT add IncludeAllContentForSelfExtract. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Debug info goes inside the exe, so error logs keep line numbers without shipping Masterplan.pdb. -->
    <DebugType>embedded</DebugType>
    <!-- Masterplan.XML (code documentation) is for developers only. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDir>bin\Publish\FrameworkDependent\</PublishDir>
  </PropertyGroup>
</Project>
