<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained single-file publish for 64-bit Windows.
     .NET 10 itself is included, so the user does not need to install anything (bigger download).
     Run:  dotnet publish Masterplan.csproj -p:PublishProfile=SelfContained-win-x64
     The Libraries\ / Projects\ folders and Manual.pdf are added by the PreparePublishFolder target
     in Masterplan.csproj. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- Only the win-x64 native files (SkiaSharp, HarfBuzz) are published, not every platform's. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- The app, its package DLLs and the .NET runtime are bundled into one exe. The two native DLLs
         (libSkiaSharp.dll, libHarfBuzzSharp.dll) stay next to the exe on purpose: that is simpler
         and more reliable than unpacking them to a temp folder at start-up.
         Do NOT add IncludeAllContentForSelfExtract. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Compresses the bundled files inside the exe (only allowed for self-contained). Smaller exe;
         start-up is slightly slower because they are decompressed in memory. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Debug info goes inside the exe, so error logs keep line numbers without shipping Masterplan.pdb. -->
    <DebugType>embedded</DebugType>
    <!-- Masterplan.XML (code documentation) is for developers only. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDir>bin\Publish\SelfContained\</PublishDir>
  </PropertyGroup>
</Project>
