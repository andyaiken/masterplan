  <!-- Properties\Resources.resx is the app's strongly typed resource file (power icons, aura, ...):
       Visual Studio regenerates Properties\Resources1.Designer.cs from it ("Masterplan.Properties.Resources").
       (These entries used to point to the project root, where the files are not, so they did nothing.
       Entries that told VS to GENERATE six forms' .Designer.cs files from their .resx were removed:
       those files are WinForms designer code, and running that generator would have overwritten them.) -->
  <ItemGroup>
    <Compile Update="Properties\Resources1.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources1.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="HtmlToOpenXml" Version="4.1.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="MessagePack.Annotations" Version="3.1.12" />
    <PackageReference Include="MessagePackAnalyzer" Version="3.1.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PuppeteerSharp" Version="25.15.0" />
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="REM 1. Copy Manual.pdf only if it exists&#xD;&#xA;if exist &quot;$(ProjectDir)..\Manual.pdf&quot; xcopy /y &quot;$(ProjectDir)..\Manual.pdf&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;&#xD;&#xA;REM 2. Create Libraries folder if it does NOT exist (using &quot;if not exist&quot;)&#xD;&#xA;if not exist &quot;$(TargetDir)Libraries&quot; md &quot;$(TargetDir)Libraries&quot;&#xD;&#xA;&#xD;&#xA;REM 3. Copy .mpxlib library files only if the source directory exists (M14 cannot read old .library files)&#xD;&#xA;if exist &quot;$(ProjectDir)..\Libraries\&quot; xcopy /y &quot;$(ProjectDir)..\Libraries\*.mpxlib&quot; &quot;$(TargetDir)Libraries\&quot;&#xD;&#xA;&#xD;&#xA;REM 4. Copy README.MD file only if it exists&#xD;&#xA;if exist &quot;$(ProjectDir)..\Libraries\README.md.txt&quot; xcopy /y &quot;$(ProjectDir)..\Libraries\README.md.txt&quot; &quot;$(TargetDir)Libraries\&quot;&#xD;&#xA;&#xD;&#xA;REM 5. Create LibraryArchive folder if it does NOT exist (using &quot;if not exist&quot;)&#xD;&#xA;if not exist &quot;$(TargetDir)Libraries\LibraryArchive&quot; md &quot;$(TargetDir)Libraries\LibraryArchive&quot;&#xD;&#xA;&#xD;&#xA;REM 6. Copy README.MD file only if it exists&#xD;&#xA;if exist &quot;$(ProjectDir)..\Libraries\LibraryArchive\README.md.txt&quot; xcopy /y &quot;$(ProjectDir)..\Libraries\LibraryArchive\README.md.txt&quot; &quot;$(TargetDir)Libraries\LibraryArchive\&quot; &#xD;&#xA;&#xD;&#xA;REM 7. Create Projects folder if it does NOT exist (using &quot;if not exist&quot;) &#xD;&#xA;if not exist &quot;$(TargetDir)Projects&quot; md &quot;$(TargetDir)Projects&quot;&#xD;&#xA;&#xD;&#xA;REM 8. Copy .mpxplan project files only if the source directory exists (M14 cannot read old .masterplan files)&#xD;&#xA;if exist &quot;$(ProjectDir)..\Projects\&quot; xcopy /y &quot;$(ProjectDir)..\Projects\*.mpxplan&quot; &quot;$(TargetDir)Projects\&quot;" />
  </Target>

  <!-- ExcludeNativePdbs: the SkiaSharp / HarfBuzzSharp packages ship native debug files
       (libSkiaSharp.pdb ~46 MB, libHarfBuzzSharp.pdb ~13 MB) for every platform, and by default they are
       copied into bin\ and the publish folder. They are only useful for debugging inside SkiaSharp's own
       C++ code, so we drop them right after NuGet works out which package files to copy.
       - RuntimeTargetsCopyLocalItems: the runtimes\<platform>\native\ files of a normal build (no RID).
       - NativeCopyLocalItems: the native files when a RuntimeIdentifier is set (e.g. publish -r win-x64).
       Only .pdb files are removed; the native .dll files themselves are untouched. -->
  <Target Name="ExcludeNativePdbs" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- PreparePublishFolder: the PostBuild step above only runs on the build output (bin\Debug, bin\Release),
       never on the publish folder. This target does the release-folder part of it after "dotnet publish":
       - copies Manual.pdf (from the repo root) if it exists;
       - ALWAYS copies the version-specific instructions PDF named in InstructionsPdf (from the repo root),
         keeping its file name (a warning is shown if it is missing; the release script then fails);
       - creates the empty Libraries\, Libraries\LibraryArchive\ and Projects\ folders (the migration tool moves converted old libraries into LibraryArchive);
       - copies Libraries\README.md.txt if it exists;
       - ALWAYS copies the shipped sample: Libraries\Sample.mpxlib and Projects\Sample.mpxplan, both made
         by the developer tool ..\Masterplan.SampleBuilder (a warning is shown if either is missing).
       The other test libraries/projects are not shipped; they are only copied when you ask for it:
         dotnet publish ... -p:PublishSampleData=true
       (copies ..\Libraries\*.mpxlib and ..\Projects\*.mpxplan; old .library/.masterplan files never).
       It also copies the migration tool ("MasterplanXP Migration Tool") into a MigrationTool\
       subfolder, where the Convert button finds it (Tools/MigrationTool.cs). The tool is a separate
       project, so PUBLISH IT FIRST (self-contained, single file):
         dotnet publish ..\MigrationTool\MasterplanXP.MigrationTool\MasterplanXP.MigrationTool.csproj -p:PublishProfile=win-x64
       If it has not been published, a warning is shown and the subfolder is left out.
       Only the tool's single exe is copied: its publish folder can also hold files from testing the
       tool there (converted files, migration_log.txt), which must not end up in the release.
       The easiest way to get the order right is the release script ..\Release\Build-Release.ps1. -->
  <Target Name="PreparePublishFolder" AfterTargets="Publish">
    <PropertyGroup>
      <_RepoRoot>$(ProjectDir)..\</_RepoRoot>
      <_MigrationPublishDir>$(_RepoRoot)MigrationTool\MasterplanXP.MigrationTool\bin\Publish\win-x64\</_MigrationPublishDir>
      <!-- The instructions document for THIS version of Masterplan. Its name carries the version, so when
           a new version gets new instructions, put the new PDF in the repo root and change this one line
           (and the same name in ..\Release\Build-Release.ps1, which checks that it was shipped).
           The file keeps this exact name in the release; it is not renamed. -->
      <InstructionsPdf>Instructions_Masterplan14.1.x_FINAL.pdf</InstructionsPdf>
    </PropertyGroup>
    <ItemGroup>
      <_SampleLibraries Include="$(_RepoRoot)Libraries\*.mpxlib" Condition="'$(PublishSampleData)' == 'true'" />
      <_SampleProjects Include="$(_RepoRoot)Projects\*.mpxplan" Condition="'$(PublishSampleData)' == 'true'" />
    </ItemGroup>
    <Warning Condition="!Exists('$(_MigrationPublishDir)MasterplanXP.MigrationTool.exe')"
             Text="The migration tool has not been published ($(_MigrationPublishDir)), so the MigrationTool folder was left out of $(PublishDir). Publish it first: dotnet publish ..\MigrationTool\MasterplanXP.MigrationTool\MasterplanXP.MigrationTool.csproj -p:PublishProfile=win-x64" />
    <!-- The tool is a self-contained single file: its exe is the whole tool. -->
    <Copy SourceFiles="$(_MigrationPublishDir)MasterplanXP.MigrationTool.exe" DestinationFolder="$(PublishDir)MigrationTool"
          Condition="Exists('$(_MigrationPublishDir)MasterplanXP.MigrationTool.exe')" />
    <MakeDir Directories="$(PublishDir)Libraries;$(PublishDir)Libraries\LibraryArchive;$(PublishDir)Projects" />
    <Copy SourceFiles="$(_RepoRoot)Manual.pdf" DestinationFolder="$(PublishDir)" Condition="Exists('$(_RepoRoot)Manual.pdf')" />
    <!-- The instructions PDF (always shipped, user's rule since 14.1.0.4). -->
    <Warning Condition="!Exists('$(_RepoRoot)$(InstructionsPdf)')"
             Text="The instructions PDF $(InstructionsPdf) is missing from the repo root, so it was left out of $(PublishDir). Every release must include it." />
    <Copy SourceFiles="$(_RepoRoot)$(InstructionsPdf)" DestinationFolder="$(PublishDir)" Condition="Exists('$(_RepoRoot)$(InstructionsPdf)')" />
    <Copy SourceFiles="$(_RepoRoot)Libraries\README.md.txt" DestinationFolder="$(PublishDir)Libraries" Condition="Exists('$(_RepoRoot)Libraries\README.md.txt')" />
    <Copy SourceFiles="@(_SampleLibraries)" DestinationFolder="$(PublishDir)Libraries" />
    <Copy SourceFiles="@(_SampleProjects)" DestinationFolder="$(PublishDir)Projects" />
    <!-- The shipped sample (always). -->
    <Warning Condition="!Exists('$(_RepoRoot)Libraries\Sample.mpxlib') Or !Exists('$(_RepoRoot)Projects\Sample.mpxplan')"
             Text="The sample library/project is missing from ..\Libraries / ..\Projects. Build it with the Masterplan.SampleBuilder tool (see its README)." />
    <Copy SourceFiles="$(_RepoRoot)Libraries\Sample.mpxlib" DestinationFolder="$(PublishDir)Libraries" Condition="Exists('$(_RepoRoot)Libraries\Sample.mpxlib')" />
    <Copy SourceFiles="$(_RepoRoot)Projects\Sample.mpxplan" DestinationFolder="$(PublishDir)Projects" Condition="Exists('$(_RepoRoot)Projects\Sample.mpxplan')" />
  </Target>
</Project>