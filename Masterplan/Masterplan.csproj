<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version, AssemblyVersion and FileVersion come from ..\Version.props, shared with the migration
       tool so both always carry the same version. Bump it THERE (rules in that file), not here. -->
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>MasterplanScroll.ico</ApplicationIcon>
    <NoWin32Manifest>true</NoWin32Manifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <!-- Nullable reference types are switched on HERE, in the project itself. It used to come only from
         E:\source\repos\Git\Directory.Build.props, a file outside this repo, so a clone anywhere else
         built with Nullable off. Legacy files still opt out with "#nullable disable" at the top. -->
    <Nullable>enable</Nullable>
	<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
	<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	<GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
    <!-- SYSLIB0011 (BinaryFormatter is obsolete) is no longer suppressed: M14 contains no BinaryFormatter
         code, so if that warning ever appears it means someone has added it back, and it would throw
         at runtime on .NET 10.
         GenerateResourceWarnOnBinaryFormatterUse above is a different thing: it is about how images are
         stored inside the forms' .resx files at build time, not about reading or saving user files. -->
    <Copyright>Copyright © 2021 - 2026 - Habitual Indolence / Gamers' Syndicate - All rights reserved. This product is protected by copyright and distributed under licences restricting copying, distribution and decompilation.</Copyright>
    <Title>Masterplan</Title>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <Product>Masterplan Adventure Design Studio</Product>
    <Description>A Dungeons &amp; Dragons 4e Adventure Design Tool</Description>
  </PropertyGroup>
  <!-- Release builds are optimized (the beta kept Optimize=false until 14.1.0.17).
       (This group used to appear twice in this file; the duplicate further down was removed.) -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DocumentationFile>bin\Release\Masterplan.XML</DocumentationFile>
  </PropertyGroup>
	<!-- CS1591 = "missing XML comment for a public member". The Release build writes Masterplan.XML
	     (DocumentationFile above), which makes the compiler report every undocumented public member:
	     about 1,000, most of them DTO properties in Dto\DtoModels.cs. They are hidden here because
	     the comments are only worth writing for the add-in API (Extensibility\), which will use the
	     XML file for add-in developers. Masterplan.XML is not shipped (PublishDocumentationFile=false).
	     Do NOT "fix" these by making classes or properties internal: MessagePack, the clipboard and the
	     tests need the DTOs to be public. -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);WFO1000;CS1591</NoWarn>
	</PropertyGroup>
  <!-- Automated tests live in a separate project, ..\Masterplan.Tests (a sibling folder, so this
       project's **/*.cs wildcard never picks them up). Masterplan does NOT reference it, so tests are
       never built into or shipped with Masterplan.
       InternalsVisibleTo lets that test project use Masterplan's internal classes (Session,
       ItemFiles, MasterplanClipboard, ...). It only adds a little metadata to Masterplan.exe and gives
       users nothing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Masterplan.Tests" />
    <!-- The developer tool that builds the shipped sample library/project (..\Masterplan.SampleBuilder).
         Same reason as the tests: it uses Session, Statistics, LibraryConversionService, ... -->
    <InternalsVisibleTo Include="Masterplan.SampleBuilder" />
  </ItemGroup>
  <!-- Every .cs file in this folder is compiled (SDK default). Excluded/dead-code files and the
       "Remove" entries for them were deleted on 2026-11-16; git history has them if needed. -->
  <ItemGroup>
    <!-- The Masterplan scroll SVG, embedded for the welcome screen (Controls\TitlePanel.cs loads it
         with GetManifestResourceStream). "None Remove" stops it also being listed as a plain file. -->
    <None Remove="Resources\masterplan_scroll.svg" />
    <EmbeddedResource Include="Resources\masterplan_scroll.svg" />
  </ItemGroup>
