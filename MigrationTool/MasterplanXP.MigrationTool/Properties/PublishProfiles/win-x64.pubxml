<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained single-file publish of "MasterplanXP Migration Tool" for 64-bit Windows.
     Self-contained: .NET 8 is included, so users do not need to install it (.NET 8 support ended in
     November 2026, and the tool needs .NET 8 for BinaryFormatter, so users should not have to install
     an unsupported runtime).
     Single file: everything, including SkiaSharp's native files, is packed into one exe, so the
     MigrationTool\ folder in the Masterplan release holds just MasterplanXP.MigrationTool.exe.
     Run:  dotnet publish MasterplanXP.MigrationTool.csproj -p:PublishProfile=win-x64
     Publish this BEFORE Masterplan: Masterplan's publish copies bin\Publish\win-x64\ into its
     MigrationTool\ subfolder (PreparePublishFolder in Masterplan.csproj). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libraries (SkiaSharp, HarfBuzz) are packed into the exe too and unpacked to a temp
         folder when the tool starts, so the release folder stays tidy. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Smaller exe; start-up is slightly slower while the bundle is decompressed. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Debug info inside the exe: logs keep line numbers without a separate .pdb file. -->
    <DebugType>embedded</DebugType>
    <PublishDir>bin\Publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>